<Window x:Class="RenomearTudo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:RenomearTudo.App.Infrastructure"
        Title="Renomear Tudo" Width="1440" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Window.Resources>
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility" />
        <infra:StatusBrushConverter x:Key="StatusBrushConverter" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Renomear Tudo" FontSize="25" FontWeight="SemiBold" />
                <TextBlock Text="Renomeação em massa com prévia, regras e rollback seguro." Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="+ Arquivos" Command="{Binding AddFilesCommand}" />
                <Button Content="+ Pasta" Command="{Binding AddFolderCommand}" />
                <Button Content="Exportar relatório" Command="{Binding ExportReportCommand}" />
                <ComboBox x:Name="ThemeCombo" Width="110" SelectedIndex="0" SelectionChanged="ThemeCombo_SelectionChanged" Margin="8,4,0,8">
                    <ComboBoxItem Content="Sistema"/><ComboBoxItem Content="Escuro"/><ComboBoxItem Content="Claro"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="290" />
            </Grid.ColumnDefinitions>

            <!-- Regras -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="210"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="REGRAS" FontWeight="SemiBold" FontSize="14" />
                    <Grid Grid.Row="1" Margin="0,10,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="RuleTypeCombo" ItemsSource="{Binding RuleTypeOptions}" DisplayMemberPath="Label" SelectedIndex="2" />
                        <Button Grid.Column="1" Content="Adicionar" Click="AddRuleType_Click" Margin="8,4,0,8"/>
                    </Grid>
                    <ListBox x:Name="RulesList" Grid.Row="2" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AllowDrop="True"
                             PreviewMouseLeftButtonDown="RulesList_PreviewMouseLeftButtonDown" MouseMove="RulesList_MouseMove" Drop="RulesList_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="↑" Command="{Binding MoveRuleUpCommand}" ToolTip="Mover regra para cima"/>
                        <Button Content="↓" Command="{Binding MoveRuleDownCommand}" ToolTip="Mover regra para baixo"/>
                        <Button Content="Excluir" Command="{Binding DeleteRuleCommand}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedRule}">
                            <TextBlock Text="Editor da regra" FontWeight="SemiBold" Margin="0,8,0,4" />
                            <TextBlock Text="Valor / padrão" Style="{StaticResource MutedText}" Visibility="{Binding ShowsText1, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBox Text="{Binding Text1, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowsText1, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="Substituir por" Style="{StaticResource MutedText}" Visibility="{Binding ShowsText2, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBox Text="{Binding Text2, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding ShowsText2, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <StackPanel Visibility="{Binding ShowsNumbering, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Início / incremento / dígitos" Style="{StaticResource MutedText}"/>
                                <UniformGrid Columns="3">
                                    <TextBox Text="{Binding NumberStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,4,8"/>
                                    <TextBox Text="{Binding NumberStep, UpdateSourceTrigger=PropertyChanged}" Margin="4,4,4,8"/>
                                    <TextBox Text="{Binding NumberPadding, UpdateSourceTrigger=PropertyChanged}" Margin="4,4,0,8"/>
                                </UniformGrid>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowsPosition, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Posição (0 = início)" Style="{StaticResource MutedText}"/>
                                <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowsCaseMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Formato" Style="{StaticResource MutedText}"/>
                                <ComboBox ItemsSource="{Binding DataContext.CaseModeOptions, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Mode" SelectedValue="{Binding CaseMode}" />
                            </StackPanel>

                            <StackPanel Visibility="{Binding ShowsRegexOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <CheckBox Content="Usar expressão regular (Regex)" IsChecked="{Binding UseRegex}" Margin="0,6"/>
                                <CheckBox Content="Ignorar maiúsculas/minúsculas" IsChecked="{Binding IgnoreCase}" Margin="0,2,0,6"/>
                                <CheckBox Content="Apenas primeira ocorrência" IsChecked="{Binding ReplaceFirstOnly}" Margin="0,2,0,6"/>
                            </StackPanel>

                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,6,0,0" Visibility="{Binding ShowsTemplateHelp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Text="Tokens: {nome} {numero} {total} {data} {pasta} {artista} {titulo} {album} {ano} {genero} {faixa}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <GroupBox Grid.Row="5" Header="Presets">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding Presets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPreset}" />
                            <TextBox Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome do preset" />
                            <UniformGrid Columns="3"><Button Content="Salvar" Command="{Binding SavePresetCommand}"/><Button Content="Carregar" Command="{Binding LoadPresetCommand}"/><Button Content="Excluir" Command="{Binding DeletePresetCommand}"/></UniformGrid>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </Border>

            <!-- Lista -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0" VerticalContentAlignment="Center" ToolTip="Buscar por nome original ou novo" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding FilterModes}" SelectedItem="{Binding FilterMode}" Margin="8,0,0,0"/>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}" Margin="8,0,0,0"/>
                        <Button Grid.Column="3" Content="Limpar" Command="{Binding ClearCommand}" Margin="8,0,0,0"/>
                    </Grid>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding FilesView}" SelectedItem="{Binding SelectedFile}" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="✓" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="42" />
                            <DataGridTextColumn Header="ORIGINAL" Binding="{Binding OriginalName, Mode=OneWay}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="NOVO NOME" Binding="{Binding PreviewName, UpdateSourceTrigger=LostFocus}" IsReadOnly="False" Width="*" />
                            <DataGridTemplateColumn Header="STATUS" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusKind, Converter={StaticResource StatusBrushConverter}}" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Detalhes / Histórico -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <TabControl>
                    <TabItem Header="Detalhes">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,12">
                                <TextBlock Text="Arquivo selecionado" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="Nome" Style="{StaticResource MutedText}" Margin="0,14,0,2"/><TextBlock Text="{Binding SelectedFile.OriginalName}" TextWrapping="Wrap"/>
                                <TextBlock Text="Novo nome" Style="{StaticResource MutedText}" Margin="0,10,0,2"/><TextBlock Text="{Binding SelectedFile.PreviewName}" TextWrapping="Wrap"/>
                                <TextBlock Text="Tamanho" Style="{StaticResource MutedText}" Margin="0,10,0,2"/><TextBlock Text="{Binding SelectedFile.Size}"/>
                                <TextBlock Text="Modificado" Style="{StaticResource MutedText}" Margin="0,10,0,2"/><TextBlock Text="{Binding SelectedFile.Modified}"/>
                                <TextBlock Text="Caminho" Style="{StaticResource MutedText}" Margin="0,10,0,2"/><TextBlock Text="{Binding SelectedFile.OriginalPath}" TextWrapping="Wrap"/>

                                <GroupBox Header="MP3 / ID3v1" Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock><Run Text="Título: "/><Run Text="{Binding SelectedFile.Metadata.Title}"/></TextBlock>
                                        <TextBlock><Run Text="Artista: "/><Run Text="{Binding SelectedFile.Metadata.Artist}"/></TextBlock>
                                        <TextBlock><Run Text="Álbum: "/><Run Text="{Binding SelectedFile.Metadata.Album}"/></TextBlock>
                                        <TextBlock><Run Text="Ano: "/><Run Text="{Binding SelectedFile.Metadata.Year}"/></TextBlock>
                                        <TextBlock><Run Text="Faixa: "/><Run Text="{Binding SelectedFile.Metadata.Track}"/></TextBlock>
                                    </StackPanel>
                                </GroupBox>
                                <Button Content="Voltar para prévia automática" Command="{Binding ResetManualNameCommand}" Margin="0,18,0,0"/>
                                <Button Content="Remover selecionado" Command="{Binding RemoveSelectedCommand}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Histórico">
                        <Grid Margin="4,12">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ListBox ItemsSource="{Binding History}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,8">
                                            <TextBlock Text="{Binding Timestamp, StringFormat={}{0:dd/MM/yyyy HH:mm}}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Count, StringFormat={}{0} arquivos}" Style="{StaticResource MutedText}"/>
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Result}" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="1" Content="Desfazer última operação" Command="{Binding UndoCommand}" Margin="0,10,0,0"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary, Mode=OneWay}" FontWeight="SemiBold" />
                    <TextBlock Text="Projeto original © 2004-2005 Daniel S. Leite" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,6,0,0">
                        <ProgressBar Width="260" Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
                        <TextBlock Text="{Binding ProgressText, Mode=OneWay}" Style="{StaticResource MutedText}" Margin="10,-4,0,0" />
                        <Button Content="Cancelar" Command="{Binding CancelCommand}" Margin="10,-8,0,-8"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource AccentButton}" Command="{Binding RenameCommand}" MinWidth="180" FontSize="14">
                    <TextBlock><Run Text="RENOMEAR "/><Run Text="{Binding ReadyCount, Mode=OneWay}"/><Run Text=" ARQUIVOS"/></TextBlock>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
