<Window x:Class="RenomearTudo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:RenomearTudo.App.Infrastructure"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Renomear Tudo"
        Width="1460" Height="900"
        MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <infra:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility" />
        <infra:ZeroToVisibilityConverter x:Key="ZeroVisibility" />
        <infra:StatusBrushConverter x:Key="StatusBrushConverter" />

        <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource FluentCard}">
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="MiniLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontFamily" Value="Segoe UI Semibold" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra de título própria para o dark mode ficar consistente em todas as versões do Windows. -->
        <Border Grid.Row="0"
                Background="{DynamicResource NavigationBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                        <TextBlock Text="R" Foreground="{DynamicResource AccentTextBrush}" FontFamily="Segoe UI Semibold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Renomear Tudo" FontFamily="Segoe UI Semibold" FontSize="13" VerticalAlignment="Center" Margin="9,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="Renomeação em massa segura"
                           Style="{StaticResource CaptionText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButton}" Content="—" ToolTip="Minimizar" Click="Minimize_Click" />
                    <Button x:Name="MaximizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource TitleBarButton}" Content="□" ToolTip="Maximizar" Click="MaximizeRestore_Click" />
                    <Button x:Name="CloseButton" shell:WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CloseTitleBarButton}" Content="×" ToolTip="Fechar" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- NavigationView-like -->
            <Border Grid.Column="0"
                    Background="{DynamicResource NavigationBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Margin="0,14,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Margin="18,4,16,0">
                        <TextBlock Text="Workspace" Style="{StaticResource MiniLabel}" />
                        <TextBlock Text="Organize nomes sem perder o controle." Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <RadioButton x:Name="RenameNav" Style="{StaticResource NavigationItem}" GroupName="MainNavigation" IsChecked="True" Click="RenameNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↔" FontFamily="Segoe UI Symbol" FontSize="16" Width="28" VerticalAlignment="Center" />
                                <TextBlock Text="Renomear" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="HistoryNav" Style="{StaticResource NavigationItem}" GroupName="MainNavigation" Click="HistoryNav_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↶" FontFamily="Segoe UI Symbol" FontSize="16" Width="28" VerticalAlignment="Center" />
                                <TextBlock Text="Histórico" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="16,0,16,2">
                        <Border Style="{StaticResource SubtleCard}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Aparência" Style="{StaticResource MiniLabel}" />
                                <ComboBox x:Name="ThemeCombo" Margin="0,8,0,0" SelectionChanged="ThemeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Sistema" />
                                    <ComboBoxItem Content="Claro" />
                                    <ComboBoxItem Content="Escuro" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Renomear Tudo 2.1.1" Style="{StaticResource CaptionText}" />
                        <TextBlock Text="Fluent UI · Windows 7/10/11" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="WorkspaceTabs" Grid.Column="1" Style="{StaticResource PageHostTabControl}" SelectedIndex="0">
                <!-- =========================================================== -->
                <!-- RENOMEAR -->
                <!-- =========================================================== -->
                <TabItem>
                    <Grid Margin="26,22,26,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Cabeçalho + CommandBar -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Renomear arquivos" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Monte as regras, confira a prévia e aplique somente quando tudo estiver certo." Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding AddFilesCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="+" FontSize="17" Margin="0,-2,7,0"/><TextBlock Text="Arquivos" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Command="{Binding AddFolderCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="+" FontSize="17" Margin="0,-2,7,0"/><TextBlock Text="Pasta" VerticalAlignment="Center"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource SubtleButton}" Command="{Binding ExportReportCommand}" Content="Exportar relatório" />
                            </StackPanel>
                        </Grid>

                        <!-- Estatísticas -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource StatCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="ARQUIVOS" Style="{StaticResource MiniLabel}" />
                                        <TextBlock Text="{Binding TotalCount, Mode=OneWay}" FontFamily="Segoe UI Semibold" FontSize="22" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="≡" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PRONTOS" Style="{StaticResource MiniLabel}" />
                                        <TextBlock Text="{Binding ReadyCount, Mode=OneWay}" FontFamily="Segoe UI Semibold" FontSize="22" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource SuccessSubtleBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="✓" FontSize="15" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="CONFLITOS" Style="{StaticResource MiniLabel}" />
                                        <TextBlock Text="{Binding ConflictCount, Mode=OneWay}" FontFamily="Segoe UI Semibold" FontSize="22" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource WarningSubtleBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="!" FontFamily="Segoe UI Semibold" FontSize="15" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Grid.Column="6" Style="{StaticResource StatCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="REGRAS" Style="{StaticResource MiniLabel}" />
                                        <TextBlock Text="{Binding Rules.Count, Mode=OneWay}" FontFamily="Segoe UI Semibold" FontSize="22" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="≋" FontSize="16" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Workspace principal -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="355" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Painel de regras -->
                            <Border Grid.Column="0" Style="{StaticResource FluentCard}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="185" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Margin="16,15,16,10">
                                        <TextBlock Text="Transformações" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="As regras são aplicadas de cima para baixo." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Grid Grid.Row="1" Margin="16,0,16,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ComboBox x:Name="RuleTypeCombo" ItemsSource="{Binding RuleTypeOptions}" DisplayMemberPath="Label" SelectedIndex="2" />
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Adicionar" Click="AddRuleType_Click" Margin="8,0,0,0" MinWidth="82" />
                                    </Grid>

                                    <ListBox x:Name="RulesList"
                                             Grid.Row="2"
                                             Margin="8,0"
                                             ItemsSource="{Binding Rules}"
                                             SelectedItem="{Binding SelectedRule}"
                                             AllowDrop="True"
                                             PreviewMouseLeftButtonDown="RulesList_PreviewMouseLeftButtonDown"
                                             MouseMove="RulesList_MouseMove"
                                             Drop="RulesList_Drop">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="⋮" Foreground="{DynamicResource TertiaryTextBrush}" FontSize="17" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontFamily="Segoe UI Semibold" FontSize="12" />
                                                        <TextBlock Text="{Binding Summary, Mode=OneWay}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Grid Grid.Row="3" Margin="12,6,12,9">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SubtleButton}" Content="↑" Command="{Binding MoveRuleUpCommand}" ToolTip="Mover para cima" Width="38" Padding="0" />
                                            <Button Style="{StaticResource SubtleButton}" Content="↓" Command="{Binding MoveRuleDownCommand}" ToolTip="Mover para baixo" Width="38" Padding="0" Margin="2,0,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Content="Remover" Command="{Binding DeleteRuleCommand}" />
                                    </Grid>

                                    <Border Grid.Row="4" Background="{DynamicResource BorderBrush}" />

                                    <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16,12,10,12">
                                        <StackPanel DataContext="{Binding SelectedRule}">
                                            <TextBlock Text="Configuração da regra" Style="{StaticResource MiniLabel}" Margin="0,0,0,9" />

                                            <StackPanel Visibility="{Binding ShowsText1, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Valor / padrão" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding Text1, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,10" />
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding ShowsText2, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Substituir por" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding Text2, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,10" />
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding ShowsNumbering, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Numeração" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                                <Grid Margin="0,0,5,10">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <StackPanel><TextBlock Text="Início" Style="{StaticResource CaptionText}"/><TextBox Text="{Binding NumberStart, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="2"><TextBlock Text="Passo" Style="{StaticResource CaptionText}"/><TextBox Text="{Binding NumberStep, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel>
                                                    <StackPanel Grid.Column="4"><TextBlock Text="Dígitos" Style="{StaticResource CaptionText}"/><TextBox Text="{Binding NumberPadding, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/></StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding ShowsPosition, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Posição (0 = início)" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                                <TextBox Text="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,10" />
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding ShowsCaseMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="Formato" Style="{StaticResource CaptionText}" Margin="0,0,0,4" />
                                                <ComboBox ItemsSource="{Binding DataContext.CaseModeOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          DisplayMemberPath="Label"
                                                          SelectedValuePath="Mode"
                                                          SelectedValue="{Binding CaseMode}"
                                                          Margin="0,0,5,10" />
                                            </StackPanel>

                                            <StackPanel Visibility="{Binding ShowsRegexOptions, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,5,7">
                                                <CheckBox Content="Usar expressão regular (Regex)" IsChecked="{Binding UseRegex}" Margin="0,4" />
                                                <CheckBox Content="Ignorar maiúsculas/minúsculas" IsChecked="{Binding IgnoreCase}" Margin="0,4" />
                                                <CheckBox Content="Somente a primeira ocorrência" IsChecked="{Binding ReplaceFirstOnly}" Margin="0,4" />
                                            </StackPanel>

                                            <Border Style="{StaticResource SubtleCard}" Margin="0,5,5,0" Visibility="{Binding ShowsTemplateHelp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <TextBlock Text="Tokens disponíveis" Style="{StaticResource MiniLabel}" />
                                                    <TextBlock Text="{}{nome}  {numero}  {total}  {data}  {pasta}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                    <TextBlock Text="{}{artista}  {titulo}  {album}  {ano}  {genero}  {faixa}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Border Grid.Row="6" Background="{DynamicResource BorderBrush}" />

                                    <Grid Grid.Row="7" Margin="16,10,16,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="7" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Presets" Style="{StaticResource MiniLabel}" VerticalAlignment="Center" />
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding Presets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPreset}" />
                                            <TextBox Grid.Column="2" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nome para salvar um novo preset" />
                                        </Grid>
                                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource SubtleButton}" Content="Carregar" Command="{Binding LoadPresetCommand}" MinHeight="28" Padding="8,3" />
                                            <Button Style="{StaticResource SubtleButton}" Content="Excluir" Command="{Binding DeletePresetCommand}" MinHeight="28" Padding="8,3" Margin="4,0,0,0" />
                                            <Button Style="{StaticResource PrimaryButton}" Content="Salvar" Command="{Binding SavePresetCommand}" MinHeight="28" Padding="10,3" Margin="4,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Lista / prévia -->
                            <Border Grid.Column="2" Style="{StaticResource FluentCard}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Margin="16,14,16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="135" />
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0" ToolTip="Buscar por nome original ou novo" />
                                            <TextBlock Text="Buscar arquivos..." VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding FilterModes}" SelectedItem="{Binding FilterMode}" Margin="8,0,0,0" />
                                        <ComboBox Grid.Column="2" ItemsSource="{Binding SortModes}" SelectedItem="{Binding SortMode}" Margin="8,0,0,0" />
                                        <Button Grid.Column="3" Style="{StaticResource SubtleButton}" Content="Limpar" Command="{Binding ClearCommand}" Margin="8,0,0,0" />
                                    </Grid>

                                    <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />

                                    <Grid Grid.Row="2">
                                        <DataGrid ItemsSource="{Binding FilesView}"
                                                  SelectedItem="{Binding SelectedFile}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="False"
                                                  SelectionMode="Single"
                                                  AlternationCount="2">
                                            <DataGrid.Columns>
                                                <DataGridCheckBoxColumn Header="" Binding="{Binding Included, UpdateSourceTrigger=PropertyChanged}" Width="46" />
                                                <DataGridTextColumn Header="NOME ORIGINAL" Binding="{Binding OriginalName, Mode=OneWay}" IsReadOnly="True" Width="*" />
                                                <DataGridTextColumn Header="PRÉVIA DO NOVO NOME" Binding="{Binding PreviewName, UpdateSourceTrigger=LostFocus}" IsReadOnly="False" Width="*" />
                                                <DataGridTemplateColumn Header="STATUS" Width="150">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Status, Mode=OneWay}" Foreground="{Binding StatusKind, Mode=OneWay, Converter={StaticResource StatusBrushConverter}}" FontFamily="Segoe UI Semibold" FontSize="11" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Empty state / drop zone -->
                                        <Border Background="{DynamicResource SurfaceBrush}" Visibility="{Binding TotalCount, Mode=OneWay, Converter={StaticResource ZeroVisibility}}" IsHitTestVisible="False">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390">
                                                <Border Width="62" Height="62" CornerRadius="16" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Center">
                                                    <TextBlock Text="+" FontSize="32" FontFamily="Segoe UI" FontWeight="Light" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0" />
                                                </Border>
                                                <TextBlock Text="Adicione seus arquivos" FontFamily="Segoe UI Semibold" FontSize="18" HorizontalAlignment="Center" Margin="0,16,0,0" />
                                                <TextBlock Text="Arraste arquivos ou pastas para esta janela, ou use os botões Arquivos e Pasta acima." Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="3" Background="{DynamicResource BorderBrush}" />

                                    <!-- Detalhes compactos do item selecionado -->
                                    <Grid Grid.Row="4" Margin="16,12,16,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="1" />
                                            <ColumnDefinition Width="190" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="ARQUIVO SELECIONADO" Style="{StaticResource MiniLabel}" />
                                            <TextBlock Text="{Binding SelectedFile.OriginalName, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Semibold" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding SelectedFile.OriginalPath, Mode=OneWay}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding SelectedFile.OriginalPath, Mode=OneWay}" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}" Margin="0,0,14,0" />

                                        <StackPanel Grid.Column="2" Margin="0,0,14,0">
                                            <TextBlock Text="DETALHES" Style="{StaticResource MiniLabel}" />
                                            <TextBlock Margin="0,4,0,0"><Run Text="Tamanho: "/><Run Text="{Binding SelectedFile.Size, Mode=OneWay}"/></TextBlock>
                                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0"><Run Text="Modificado: "/><Run Text="{Binding SelectedFile.Modified, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>

                                        <Border Grid.Column="3" Background="{DynamicResource BorderBrush}" Margin="0,0,14,0" />

                                        <StackPanel Grid.Column="4" Margin="0,0,14,0">
                                            <TextBlock Text="MP3 / ID3" Style="{StaticResource MiniLabel}" />
                                            <TextBlock Text="{Binding SelectedFile.Metadata.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            <TextBlock Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"><Run Text="{Binding SelectedFile.Metadata.Artist, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SelectedFile.Metadata.Album, Mode=OneWay}"/></TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SubtleButton}" Content="Restaurar prévia" Command="{Binding ResetManualNameCommand}" Margin="0,0,6,0" />
                                            <Button Style="{StaticResource DangerButton}" Content="Remover" Command="{Binding RemoveSelectedCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Action bar -->
                        <Border Grid.Row="6" Style="{StaticResource FluentCard}" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Summary, Mode=OneWay}" FontFamily="Segoe UI Semibold" />
                                    <Grid Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,24,0" MaxWidth="620" HorizontalAlignment="Left">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}" />
                                        <TextBlock Grid.Row="2" Text="{Binding ProgressText, Mode=OneWay}" Style="{StaticResource CaptionText}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SubtleButton}" Content="Cancelar" Command="{Binding CancelCommand}" Visibility="{Binding IsBusy, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding RenameCommand}" MinWidth="210" MinHeight="40" FontSize="13">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="Renomear" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="Segoe UI Semibold" />
                                            <Border Background="#24FFFFFF" CornerRadius="9" Padding="7,1" Margin="9,0,0,0">
                                                <TextBlock Text="{Binding ReadyCount, Mode=OneWay}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" FontFamily="Segoe UI Semibold" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- =========================================================== -->
                <!-- HISTÓRICO -->
                <!-- =========================================================== -->
                <TabItem>
                    <Grid Margin="26,22,26,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Histórico" Style="{StaticResource PageTitle}" />
                                <TextBlock Text="Consulte as operações anteriores e desfaça a última alteração quando necessário." Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="Desfazer última operação" Command="{Binding UndoCommand}" MinWidth="190" VerticalAlignment="Center" />
                        </Grid>

                        <Border Grid.Row="2" Style="{StaticResource FluentCard}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Margin="18,14">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Operações recentes" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="O histórico é armazenado localmente e usado pelo recurso de desfazer." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Style="{StaticResource SubtleCard}" Padding="10,6" VerticalAlignment="Center">
                                        <TextBlock><Run Text="{Binding History.Count, Mode=OneWay}" FontFamily="Segoe UI Semibold"/><Run Text=" operações"/></TextBlock>
                                    </Border>
                                </Grid>
                                <Border Grid.Row="1" Background="{DynamicResource BorderBrush}" />
                                <ListBox Grid.Row="2" ItemsSource="{Binding History}" Margin="10,8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="150" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Timestamp, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy}}" FontFamily="Segoe UI Semibold" />
                                                    <TextBlock Text="{Binding Timestamp, Mode=OneWay, StringFormat={}{0:HH:mm}}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="ARQUIVOS" Style="{StaticResource MiniLabel}" />
                                                    <TextBlock Text="{Binding Count, Mode=OneWay}" FontFamily="Segoe UI Semibold" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,18,0">
                                                    <TextBlock Text="LOCAL" Style="{StaticResource MiniLabel}" />
                                                    <TextBlock Text="{Binding Folder, Mode=OneWay}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Folder, Mode=OneWay}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="RESULTADO" Style="{StaticResource MiniLabel}" />
                                                    <TextBlock Text="{Binding Result, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}" FontFamily="Segoe UI Semibold" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
